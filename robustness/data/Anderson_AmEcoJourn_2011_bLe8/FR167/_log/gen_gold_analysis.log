##################### Multi 100
### Title: Caste as an Impediment to Trade
### Author: Siwan Anderson
### Paper ID: Anderson_AmEcoJourn_2011_bLe8

# Claim: ... [the study] finds substantially higher income for low-caste households residing in villages 
# dominated by BACs [compared to villages dominated by upper caste]. (p. 240.)

# Load basic packages
library(haven)
library(dplyr)
library(parameters)

# Import main data
d <- read_dta('household.dta')


########################## Compare with Table2 because their Ns seem to differ
# Import table2 data
table2 <- read_dta('table2.dta')

selected <- d %>%
  dplyr::select('hhcode', 'domlow')

selected_table2 <- table2 %>%
  dplyr::select('hhcode', 'domhigh')

check <- left_join(selected_table2, selected, by='hhcode')

############### Are there any inconsistencies across domlow and domhigh?
check <- check %>%
  mutate(Different = if_else(domlow == domhigh, 1, 0))
############### Is there a missing in one dataset but not the other?
check <- check %>%
  mutate(Different = if_else(!is.na(domlow) & is.na(domhigh) | is.na(domlow) & !is.na(domhigh) , 1, 0))
table(check$Different)

####### There are two cases of households that are missing from the main dataframe but not from Table 2
which_missing <- check %>%
  filter(Different == TRUE)
table(which_missing$hhcode)
#### Household 2506 and 9204 are missing from the main file

########### Merge domhigh from Table 2 with main file
table2 <- table2 %>%
  select("hhcode", "domhigh") %>%
  rename("domhigh_from_table2" = domhigh)
##### merge datasets
d <- left_join(table2, d, by='hhcode')

######################################################################################
############################   PREPARING FOR MULTILEVELS  ############################
######################################################################################
#### Create factor
library(lme4)
library('merTools')
library(directlabels)
library(ggplot2)
d$village_factor <- factor(d$village)

