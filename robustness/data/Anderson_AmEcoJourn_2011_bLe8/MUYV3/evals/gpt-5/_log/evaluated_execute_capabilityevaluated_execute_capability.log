# Utility: outlier mask using 1.5*IQR on log-transformed series

def iqr_outlier_mask_log(y: pd.Series):
    ylog = np.log(y)
    q1 = np.nanpercentile(ylog, 25)
    q3 = np.nanpercentile(ylog, 75)
    iqr = q3 - q1
    lower = q1 - 1.5 * iqr
    upper = q3 + 1.5 * iqr
    return (ylog >= lower) & (ylog <= upper)


