        if col in df.columns:
            df[f"{col}_ec"] = effect_code(df[col].astype(int))
    return df


def robust_glm_poisson(formula, data):
    model = smf.glm(formula=formula, data=data, family=sm.families.Poisson()).fit()
    rob = model.get_robustcov_results(cov_type="HC0")
    return rob


def summarise_glm_results(rob):
    params = rob.params
    bse = rob.bse
    pvals = rob.pvalues
    conf = rob.conf_int(alpha=0.05)
    irr = np.exp(params)
    irr_ci_lower = np.exp(conf[:, 0])
    irr_ci_upper = np.exp(conf[:, 1])
    irr_se = irr * bse
    out = {}
    for i, name in enumerate(rob.model.exog_names):
        out[name] = {
            "coef": float(params[i]),
            "se_robust": float(bse[i]),
            "p_value": float(pvals[i]),
            "ci_lower": float(conf[i, 0]),
            "ci_upper": float(conf[i, 1]),
            "irr": float(irr[i]),
            "irr_se_delta": float(irr_se[i]),
            "irr_ci_lower": float(irr_ci_lower[i]),
            "irr_ci_upper": float(irr_ci_upper[i]),
        }
    return out


