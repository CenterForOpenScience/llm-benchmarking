    s = pd.to_numeric(s, errors='coerce')
    m = s.mean(skipna=True)
    sd = s.std(ddof=0, skipna=True)
    if pd.isna(sd) or sd == 0:
        return pd.Series(np.zeros(len(s)), index=s.index)
    return (s - m) / sd


